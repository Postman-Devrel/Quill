# Required secrets — set these via `ast project configure` before `ast project start`.
# Local development reads these from a .env file at the Quill/ root.

# Anthropic — auto-injected by the platform when astropods.yml declares
# `models.anthropic.provider: anthropic`. For local-only smoke tests you can
# set it directly here.
ANTHROPIC_API_KEY=

# Tavily — web research for the write_draft tool
TAVILY_API_KEY=

# WordPress — blog.postman.com REST API auth (Application Password)
WP_USERNAME=
WP_APP_PASSWORD=

# Confluence — a single service-account identity + shared destination space.
# All Quill blog drafts get saved to CONFLUENCE_SPACE_KEY under the identity
# of CONFLUENCE_EMAIL (should be a bot account like quill@postman.com, not a
# personal email).
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=
# CONFLUENCE_PARENT_PAGE_ID=       # optional — nest drafts under this page ID
# CONFLUENCE_BASE_URL=             # optional — defaults to postmanlabs.atlassian.net/wiki

# GitHub — fine-grained PAT with Contents:read on Postman-Devrel/devrel-claude-code-skills.
# Lets write-draft fetch the shared blog-write SKILL.md at runtime so prompt updates
# propagate without a redeploy. Required if the skills repo is private.
GITHUB_SKILLS_TOKEN=

# Google — service account for creating drafts in Google Docs (Drive API).
# Required for reading and creating Google Docs. Enable the Drive API and share
# source docs or their parent folder with the service-account email as Viewer.
#
# Required for deployment (Astropods secrets/vars only hold strings, not files):
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Local-dev alternative to the two vars above — path to the service account's JSON key
# file, read directly. Same convention as Google's own client libraries and the
# devrel-claude-code-skills meetup-calendar skill. NOT usable once deployed.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
#
# Optional, purely organizational — files new docs under this Drive folder ID. Every new
# doc is already shared "anyone with the link can edit" on its own, so this is NOT required
# for access — only set it if you want drafts filed somewhere specific instead of the
# service account's own Drive root.
# GOOGLE_DRIVE_FOLDER_ID=

# Optional — OpenTelemetry collector endpoint (defaults to localhost:4318)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
